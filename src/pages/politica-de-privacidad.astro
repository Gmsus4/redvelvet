---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const currentYear = new Date().getFullYear();

const sections = [
  {
    title: 'Qué información recopilamos',
    description: 'Al realizar un pedido podemos solicitar tu nombre, teléfono, correo, dirección de entrega y detalles necesarios para preparar o coordinar tu pedido.',
  },
  {
    title: 'Para qué usamos tus datos',
    description: 'Usamos esta información únicamente para confirmar pedidos, resolver dudas, coordinar entregas y dar seguimiento a la atención que nos solicitaste.',
  },
  {
    title: 'Cómo cuidamos tu información',
    description: 'Tratamos tus datos con confidencialidad. No vendemos, rentamos ni compartimos tu información personal con terceros para fines publicitarios.',
  },
  {
    title: 'Mensajes y redes sociales',
    description: 'Si nos contactas por WhatsApp, Instagram, TikTok o Facebook, también aplican las políticas de privacidad de esas plataformas.',
  },
  {
    title: 'Eliminación de datos',
    description: 'Puedes pedir que eliminemos tu información de nuestros registros escribiéndonos por cualquiera de nuestros canales de contacto.',
  },
  {
    title: 'Cambios a esta política',
    description: 'Podemos actualizar esta política cuando sea necesario. La versión vigente estará publicada en esta misma página.',
  },
];
---

<Layout title="Política de privacidad - Redvelvet pastelería">
  <Navbar />

  <main class="w-full px-6 pb-24 pt-34">
    <section class="mx-auto grid w-full max-w-5xl gap-12 md:grid-cols-[0.95fr_1.05fr] md:items-end">
      <div class="relative">
        <img src="/pastel.png" alt="" class="pointer-events-none absolute right-0 top-4 hidden w-20 select-none md:block" />

        <p class="font-[Caveat] text-6xl font-bold leading-none text-primary">Privacidad</p>
        <h1 class="mt-5 max-w-xl text-balance text-3xl font-black leading-tight text-primary sm:text-4xl">
          Tus datos se usan solo para cuidar tu pedido.
        </h1>

        <div class="mt-4 max-w-md space-y-4 text-base font-bold leading-8 text-copy">
          <p>
            En Redvelvet tratamos tu información con cuidado. Esta página explica qué datos pedimos y cómo los usamos cuando nos contactas o haces un pedido.
          </p>
          <p class="text-sm text-softcopy">
            Última actualización: {currentYear}
          </p>
        </div>
      </div>

      <div class="relative h-52 w-full max-w-sm justify-self-center md:justify-self-end">
        <img src="/mujer.png" alt="" class="absolute bottom-0 left-16 w-44" />
        <img src="/gato.png" alt="" class="absolute bottom-0 left-0 w-28" />
        <img src="/florero.png" alt="" class="absolute bottom-0 right-16 w-12" />
      </div>
    </section>

    <section class="mx-auto mt-12 grid w-full max-w-5xl gap-3 md:grid-cols-2">
      {sections.map((section) => (
        <article class="rounded-[2rem] bg-secondary/20 px-5 py-4 text-primary">
          <h2 class="font-[Caveat] text-3xl font-bold leading-none">{section.title}</h2>
          <p class="mt-3 text-sm font-bold leading-7 text-copy">{section.description}</p>
        </article>
      ))}
    </section>

    <section class="mx-auto mt-12 flex w-full max-w-5xl flex-col gap-4 rounded-[2rem] border-2 border-primary bg-secondary/25 p-5 text-primary shadow-[5px_5px_0_#ef2f7f] sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-base font-bold leading-8 text-copy">
        Si tienes dudas sobre el manejo de tu información, puedes escribirnos directamente.
      </p>
      <a href="/contact" class="inline-flex rounded-full bg-primary px-5 py-3 text-sm font-black text-white shadow-[3px_3px_0_#f9a2b4] transition hover:bg-primary/90">
        Contactar
      </a>
    </section>
  </main>

  <Footer />
</Layout>
