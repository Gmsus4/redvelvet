---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";

const orderFormUrl = "#";
const whatsappUrl = "https://wa.me/5215512345678?text=Hola%2C%20quiero%20agendar%20un%20pedido";

const contactInfo = [
  { label: "Instagram", value: "@redvelvet_pasteleria", url: "#" },
  { label: "Facebook", value: "RedVelvet pasteleria", url: "#" },
  { label: "WhatsApp", value: "+52 55 1234 5678", url: whatsappUrl },
  { label: "Correo", value: "RedVelvetpasteleria19@gmail.com", url: "mailto:RedVelvetpasteleria19@gmail.com" },
];

const orderInfo = ["Fecha de entrega", "Personas aproximadas", "Producto o idea", "Colores o referencias"];
---

<Layout title="Contacto - Redvelvet pasteleria">
  <Navbar />
  <main class="grid w-full place-items-center px-6 pb-10 pt-28 md:px-10 md:pt-34">
    <section class="grid w-full max-w-6xl gap-10 md:grid-cols-[0.95fr_1.05fr] md:items-center">
      <div class="flex flex-col items-center text-center md:items-start md:text-left">
        <p class="mb-4 rounded-full bg-secondary/25 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-primary">
          Agenda tu pedido
        </p>
        <h1 class="max-w-[12ch] font-hero text-[clamp(2.8rem,8vw,5.25rem)] font-normal leading-[0.95] text-secondary md:max-w-[11ch]">
          <span class="text-primary">Hablemos</span><br />
          de tu proximo postre.
        </h1>
        <p class="mt-6 max-w-md text-base font-bold leading-8 text-copy md:text-lg">
          Cuentanos la fecha, la idea, los sabores y el estilo. Te ayudamos a aterrizarlo en algo bonito y delicioso.
        </p>

        <div class="mt-7 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row md:items-start">
          <a href={orderFormUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-primary px-8 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-primary/90 sm:w-auto">
            Formulario para agendar
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-primary/25 bg-white/55 px-8 text-sm font-black text-primary transition hover:-translate-y-0.5 hover:bg-white sm:w-auto">
            WhatsApp
          </a>
        </div>
      </div>

      <div class="grid gap-5">
        <div class="grid gap-3 rounded-[2rem] border border-primary/10 bg-white/45 p-4 backdrop-blur-sm">
          {contactInfo.map(({ label, value, url }) => (
            <a
              href={url}
              target={url.startsWith("http") ? "_blank" : undefined}
              rel={url.startsWith("http") ? "noopener noreferrer" : undefined}
              class="group flex items-center justify-between gap-4 rounded-2xl bg-cream/70 px-4 py-3 transition hover:bg-white"
            >
              <span class="text-xs font-black uppercase tracking-[0.16em] text-primary">{label}</span>
              <span class="break-all text-right text-sm font-bold text-copy">{value}</span>
            </a>
          ))}
        </div>

        <div class="flex flex-wrap gap-2">
          {orderInfo.map((detail) => (
            <span class="rounded-full border border-primary/12 bg-cream/80 px-3.5 py-2 text-xs font-black text-softcopy backdrop-blur-sm">
              {detail}
            </span>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
