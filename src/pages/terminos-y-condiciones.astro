---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const terms = [
  {
    title: 'Anticipación del pedido',
    description: 'Todos los pedidos deben realizarse con un mínimo de 3 días de anticipación. De preferencia con 1 semana de antelación, ya que regularmente nuestra agenda se llena con rapidez.',
  },
  {
    title: 'Pago y confirmación',
    description: 'Para poder agendar tu pedido se solicita el depósito o transferencia del 100% del total. Tu pedido queda confirmado una vez recibido el pago.',
  },
  {
    title: 'Servicio a domicilio',
    description: 'Contamos con servicio a domicilio dentro de Córdoba, Peñuela, Fortín, Orizaba y Yanga.',
  },
  {
    title: 'Entregas',
    description: 'Según el producto, podemos enviar repartidores de confianza, aunque regularmente nosotros realizamos las entregas personalmente.',
  },
  {
    title: 'Responsabilidad durante el transporte',
    description: 'Si tú eres el encargado de transportar tu producto, no nos hacemos responsables de cualquier incidente que ocurra durante el traslado.',
  },
  {
    title: 'Conservación del producto',
    description: 'Recuerda que hay ciertos postres que pueden permanecer un tiempo fuera del refrigerador y otros que es necesario mantener dentro de él. Sigue siempre las instrucciones que vienen en cada producto.',
  },
  {
    title: 'Verificación de datos',
    description: 'Una vez realizado tu depósito de confirmación, verifica que toda la información sea correcta: sabor, diseño, fecha, hora, dirección, nombre y número telefónico.',
  },
];
---

<Layout title="Términos y condiciones - redvelvet_pasteleria">
  <Navbar />
  <main class="bg-cream">
    <section class="section-shell py-16 md:py-24">
      <a href="/" class="mb-8 inline-flex items-center gap-2 text-sm font-black text-primary hover:text-[#a71943]">
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Volver al inicio
      </a>

      <div class="max-w-3xl">
        <p class="eyebrow mb-4">Legal</p>
        <h1 class="display-title text-4xl sm:text-5xl">Términos y condiciones</h1>
        <p class="mt-5 text-base font-bold leading-8 text-black/70">
          Al realizar un pedido con nosotros aceptas los siguientes términos. Por favor léelos con atención antes de agendar.
        </p>
      </div>

      <div class="mt-10 grid gap-3">
        {terms.map((term, index) => (
          <article class="grid gap-4 rounded-lg border-2 border-black bg-white p-5 shadow-[4px_4px_0_#080808] sm:grid-cols-[auto_1fr]">
            <span class="grid h-11 w-11 place-items-center rounded-md border-2 border-black bg-primary text-sm font-black text-white">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 class="font-body text-2xl font-black text-black">{term.title}</h2>
              <p class="mt-2 text-sm font-bold leading-7 text-black/68">{term.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 rounded-lg border-2 border-black bg-primary p-7 text-center text-white shadow-[6px_6px_0_#080808]">
        <p class="font-body text-2xl font-black">¿Tienes alguna duda sobre nuestros términos?</p>
        <a href="/#contacto" class="btn-light mt-5">Contáctanos</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
