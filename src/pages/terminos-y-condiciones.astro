---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const terms = [
  {
    title: 'Anticipación del pedido',
    description: 'Todos los pedidos deben realizarse con un mínimo de 3 días de anticipación. De preferencia con 1 semana, ya que la agenda suele llenarse con rapidez.',
  },
  {
    title: 'Pago y confirmación',
    description: 'Para agendar tu pedido se solicita depósito o transferencia del 100% del total. El pedido queda confirmado una vez recibido el pago.',
  },
  {
    title: 'Servicio a domicilio',
    description: 'Contamos con servicio a domicilio dentro de Córdoba, Peñuela, Fortín, Orizaba y Yanga.',
  },
  {
    title: 'Entregas',
    description: 'Según el producto, podemos enviar repartidores de confianza, aunque regularmente realizamos las entregas personalmente.',
  },
  {
    title: 'Responsabilidad durante el transporte',
    description: 'Si tú transportas tu producto, no nos hacemos responsables de cualquier incidente que ocurra durante el traslado.',
  },
  {
    title: 'Conservación del producto',
    description: 'Algunos postres pueden permanecer un tiempo fuera del refrigerador y otros necesitan mantenerse fríos. Sigue siempre las instrucciones de cada producto.',
  },
  {
    title: 'Verificación de datos',
    description: 'Una vez realizado tu depósito, verifica que sabor, diseño, fecha, hora, dirección, nombre y teléfono sean correctos.',
  },
];
---

<Layout title="Términos y condiciones - Redvelvet pastelería">
  <Navbar />

  <main class="w-full px-6 pb-24 pt-34">
    <section class="mx-auto grid w-full max-w-5xl gap-12 md:grid-cols-[0.95fr_1.05fr] md:items-end">
      <div class="relative">
        <img src="/pastel.png" alt="" class="pointer-events-none absolute right-0 top-4 hidden w-20 select-none md:block" />

        <p class="font-[Caveat] text-6xl font-bold leading-none text-primary">Términos</p>
        <h1 class="mt-5 max-w-xl text-balance text-3xl font-black leading-tight text-primary sm:text-4xl">
          Para que tu pedido salga bonito y sin vueltas.
        </h1>

        <div class="mt-4 max-w-md space-y-4 text-base font-bold leading-8 text-copy">
          <p>
            Al realizar un pedido con Redvelvet aceptas estas condiciones. Léelas con calma antes de apartar tu fecha.
          </p>
          <p>
            La idea es cuidar tu pedido, tu tiempo y el proceso de preparación.
          </p>
        </div>
      </div>

      <div class="relative h-52 w-full max-w-sm justify-self-center md:justify-self-end">
        <img src="/mujer.png" alt="" class="absolute bottom-0 left-16 w-44" />
        <img src="/gato.png" alt="" class="absolute bottom-0 left-0 w-28" />
        <img src="/florero.png" alt="" class="absolute bottom-0 right-16 w-12" />
      </div>
    </section>

    <section class="mx-auto mt-12 grid w-full max-w-5xl gap-3 md:grid-cols-2">
      {terms.map((term) => (
        <article class="rounded-[2rem] bg-secondary/20 px-5 py-4 text-primary">
          <h2 class="font-[Caveat] text-3xl font-bold leading-none">{term.title}</h2>
          <p class="mt-3 text-sm font-bold leading-7 text-copy">{term.description}</p>
        </article>
      ))}
    </section>

    <section class="mx-auto mt-12 flex w-full max-w-5xl flex-col gap-4 rounded-[2rem] border-2 border-primary bg-secondary/25 p-5 text-primary shadow-[5px_5px_0_#ef2f7f] sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-base font-bold leading-8 text-copy">
        Si tienes dudas antes de confirmar tu pedido, escríbenos y te ayudamos a revisar los detalles.
      </p>
      <a href="/contact" class="inline-flex rounded-full bg-primary px-5 py-3 text-sm font-black text-white shadow-[3px_3px_0_#f9a2b4] transition hover:bg-primary/90">
        Contactar
      </a>
    </section>
  </main>

  <Footer />
</Layout>
