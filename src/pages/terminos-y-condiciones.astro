---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const terms = [
  {
    title: 'Anticipacion del pedido',
    description: 'Todos los pedidos deben realizarse con un minimo de 3 dias de anticipacion. De preferencia con 1 semana, ya que la agenda suele llenarse con rapidez.',
  },
  {
    title: 'Pago y confirmacion',
    description: 'Para agendar tu pedido se solicita deposito o transferencia del 100% del total. El pedido queda confirmado una vez recibido el pago.',
  },
  {
    title: 'Servicio a domicilio',
    description: 'Contamos con servicio a domicilio dentro de Cordoba, Penuela, Fortin, Orizaba y Yanga.',
  },
  {
    title: 'Entregas',
    description: 'Segun el producto, podemos enviar repartidores de confianza, aunque regularmente realizamos las entregas personalmente.',
  },
  {
    title: 'Responsabilidad durante el transporte',
    description: 'Si tu transportas tu producto, no nos hacemos responsables de cualquier incidente que ocurra durante el traslado.',
  },
  {
    title: 'Conservacion del producto',
    description: 'Algunos postres pueden permanecer un tiempo fuera del refrigerador y otros necesitan mantenerse frios. Sigue siempre las instrucciones de cada producto.',
  },
  {
    title: 'Verificacion de datos',
    description: 'Una vez realizado tu deposito, verifica que sabor, diseno, fecha, hora, direccion, nombre y telefono sean correctos.',
  },
];
---

<Layout title="Terminos y condiciones - Redvelvet pasteleria">
  <Navbar />

  <main class="grid w-full place-items-center px-6 pb-8 pt-32 md:pt-36">
    <div class="grid w-full max-w-2xl place-items-center gap-10">
      <div class="relative h-64 w-full max-w-sm">
        <img src="/mujer.png" alt="" class="absolute bottom-0 left-1/2 w-64 -translate-x-1/2" />
        <img src="/pastel.png" alt="" class="absolute bottom-0 left-1/2 w-22 -translate-x-28" />
        <img src="/gato.png" alt="" class="absolute bottom-0 left-0 w-34 sm:-left-8" />
        <img src="/florero.png" alt="" class="absolute bottom-0 right-2 w-14 sm:-right-4" />
      </div>

      <section class="flex w-full flex-col gap-4">
        <p class="font-[Caveat] text-5xl font-bold leading-none text-primary md:text-6xl">Terminos</p>
        <h1 class="text-balance text-2xl font-black leading-tight text-copy md:text-3xl">
          Para que tu pedido salga bonito y sin vueltas.
        </h1>
        <p class="text-base font-bold leading-8 text-copy">
          Al realizar un pedido con Redvelvet aceptas estas condiciones. Leelas con calma antes de apartar tu fecha.
        </p>
        <p class="text-base font-bold leading-8 text-copy">
          La idea es cuidar tu pedido, tu tiempo y el proceso de preparacion.
        </p>
      </section>

      <section class="grid w-full gap-3">
        {terms.map((term, index) => (
          <article class="grid grid-cols-[auto_1fr] gap-4 rounded-3xl border border-primary/10 bg-white/65 px-5 py-4 shadow-[0_12px_30px_rgb(239_47_127_/_0.08)] backdrop-blur-sm">
            <span class="pt-1 font-[Caveat] text-3xl font-bold leading-none text-primary">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 class="text-sm font-black uppercase leading-5 text-primary">{term.title}</h2>
              <p class="mt-2 text-sm font-bold leading-7 text-copy">{term.description}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="flex w-full flex-col gap-4 rounded-3xl border border-primary/15 bg-secondary/18 p-5 shadow-[0_14px_34px_rgb(239_47_127_/_0.1)] sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-md text-base font-bold leading-8 text-copy">
          Si tienes dudas antes de confirmar tu pedido, escribenos y te ayudamos a revisar los detalles.
        </p>
        <a href="/contact" class="inline-flex w-fit rounded-full bg-primary px-6 py-3 text-sm font-black text-white shadow-[0_12px_30px_rgb(239_47_127_/_0.22)] transition hover:-translate-y-0.5 hover:bg-primary/90">
          Contactar
        </a>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
