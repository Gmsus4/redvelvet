---
import Footer from "../components/Footer.astro";
import Recommendations from "../components/Recommendations.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";

const products = [
  { name: "Mostachon", description: "Galleta crujiente, crema y fresas frescas.", image: "/products/mostachon.jpg" },
  { name: "Donas con toppings", description: "Esponjosas y decoradas a tu gusto.", image: "/products/donas.jpg" },
  { name: "Mini cakes", description: "Pastelitos individuales para cualquier antojo.", image: "/products/minicakes.jpg" },
  { name: "New York cookies", description: "Grandes, suaves por dentro y crujientes por fuera.", image: "/products/cookies.jpg" },
  { name: "Cupcakes", description: "Decorados a mano en sabores que enamoran.", image: "/products/cupcakes.jpg" },
  { name: "Brownies", description: "Fudgy, chocolatosos y con toppings.", image: "/products/brownies.jpg" },
  { name: "Fresas con chocolate", description: "Frescas, cubiertas y decoradas con detalle.", image: "/products/fresas.jpg" },
  { name: "Pasteles personalizados", description: "Disenos especiales para celebrar bonito.", image: "/products/pasteles.jpg" },
  { name: "Cheesecakes", description: "Cremosos y con toppings irresistibles.", image: "/products/cheesecake.jpg" },
];
---

<Layout title="Productos - Redvelvet pasteleria">
  <Navbar />
  <main class="grid w-full place-items-center px-6 pb-10 pt-28 md:px-10 md:pt-34">
    <div class="grid w-full max-w-6xl gap-14">
      <section class="grid gap-10 md:grid-cols-[0.95fr_1.05fr] md:items-center">
        <div class="flex flex-col items-center text-center md:items-start md:text-left">
          <p class="mb-4 rounded-full bg-secondary/25 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-primary">
            Catalogo dulce
          </p>
          <h1 class="max-w-[12ch] font-hero text-[clamp(2.8rem,8vw,5.25rem)] font-normal leading-[0.95] text-secondary md:max-w-[11ch]">
            <span class="text-primary">Productos</span><br />
            para antojos y celebraciones.
          </h1>
          <p class="mt-6 max-w-md text-base font-bold leading-8 text-copy md:text-lg">
            Hechos con ingredientes de calidad, mucho carino y ese toque especial que los hace inolvidables.
          </p>
        </div>

        <div class="relative mx-auto grid w-full max-w-[30rem] place-items-center">
          <div class="absolute inset-x-8 bottom-0 top-10 rounded-[2.5rem] bg-secondary/18"></div>
          <figure class="relative z-10 w-[78%] overflow-hidden rounded-[2rem] border border-primary/12 bg-white p-2 shadow-[0_22px_50px_rgb(239_47_127_/_0.16)]">
            <img src="/products/pasteles.jpg" alt="Pastel personalizado Redvelvet" class="aspect-[4/5] w-full rounded-[1.5rem] object-cover" />
          </figure>
          <figure class="absolute bottom-10 left-2 z-20 w-[34%] overflow-hidden rounded-full border-4 border-cream bg-white">
            <img src="/products/fresas.jpg" alt="Fresas con chocolate" class="aspect-square w-full object-cover" />
          </figure>
          <figure class="absolute bottom-4 right-4 z-20 w-[36%] overflow-hidden rounded-full border-4 border-cream bg-white">
            <img src="/products/cupcakes.jpg" alt="Cupcakes" class="aspect-square w-full object-cover" />
          </figure>
        </div>
      </section>

      <section class="grid w-full grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {products.map(({ name, description, image }) => (
          <article class="group relative flex flex-col items-center gap-3 text-center">
            <div class="relative h-32 w-32 shrink-0 overflow-hidden rounded-full border border-primary/12 bg-white p-1 transition group-hover:-translate-y-1 sm:h-36 sm:w-36">
              <img src={image} alt={name} class="h-full w-full rounded-full object-cover" />
            </div>
            <div class="flex max-w-40 flex-col gap-1">
              <h2 class="text-sm font-black leading-tight text-primary">{name.toUpperCase()}</h2>
              <p class="text-xs font-bold leading-5 text-softcopy">{description}</p>
            </div>
          </article>
        ))}
      </section>

      <Recommendations />
    </div>
  </main>
  <Footer />
</Layout>
