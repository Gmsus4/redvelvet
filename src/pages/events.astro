---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";

const gallery = [
  { src: "/products/pasteles.jpg", alt: "Pastel personalizado para evento" },
  { src: "/products/mostachon.jpg", alt: "Mesa de postres con mostachon" },
  { src: "/products/cheesecake.jpg", alt: "Pastel decorado para celebracion" },
  { src: "/products/cupcakes.jpg", alt: "Cupcakes para mesa dulce" },
  { src: "/products/fresas.jpg", alt: "Fresas cubiertas con chocolate" },
];

const options = ["Pasteles personalizados", "Mesa dulce", "Postres individuales", "Diseno por tematica"];
---

<Layout title="Eventos - Redvelvet pasteleria">
  <Navbar />
  <main class="grid w-full place-items-center px-6 pb-10 pt-28 md:px-10 md:pt-34">
    <div class="grid w-full max-w-6xl gap-12">
      <section class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-center">
        <div class="flex flex-col items-center text-center md:items-start md:text-left">
          <p class="mb-4 rounded-full bg-secondary/25 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-primary">
            Eventos dulces
          </p>
          <h1 class="max-w-[12ch] font-hero text-[clamp(2.8rem,8vw,5.25rem)] font-normal leading-[0.95] text-secondary md:max-w-[11ch]">
            <span class="text-primary">Mesas dulces</span><br />
            y pasteles para tu evento.
          </h1>
          <p class="mt-6 max-w-md text-base font-bold leading-8 text-copy md:text-lg">
            Armamos propuestas para cumpleanos, bodas, reuniones, aniversarios y celebraciones especiales.
          </p>
          <div class="mt-7 flex flex-wrap justify-center gap-2 md:justify-start">
            {options.map((option) => (
              <span class="rounded-full border border-primary/12 bg-cream/80 px-3.5 py-2 text-xs font-black text-softcopy backdrop-blur-sm">
                {option}
              </span>
            ))}
          </div>
          <a href="/contact" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-8 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-primary/90">
            Cotizar evento
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {gallery.map((image, index) => (
            <figure class:list={[
              "overflow-hidden rounded-[1.5rem] border border-primary/10 bg-white p-1",
              index === 0 ? "col-span-2 sm:row-span-2" : "",
            ]}>
              <img src={image.src} alt={image.alt} class="aspect-square h-full w-full rounded-[1.15rem] object-cover" />
            </figure>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
