---
const WHATSAPP_URL = 'https://wa.me/521XXXXXXXXXX?text=Hola%20Ari%2C%20me%20gustar%C3%ADa%20agendar%20un%20pedido';
const EMAIL = 'contacto@redvelvetpasteleria.com';

const socials = [
  {
    name: 'Instagram',
    handle: '@redvelvet_pasteleria',
    url: '#',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5h.01" />
    </svg>`,
  },
  {
    name: 'TikTok',
    handle: '@redvelvet_pasteleria',
    url: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.7 3c.42 2.46 1.78 3.95 4.1 4.1v3.05a7.2 7.2 0 0 1-4.05-1.25v6.15c0 3.2-2.36 5.95-5.77 5.95-3.16 0-5.78-2.37-5.78-5.62 0-3.66 3.46-6.33 7.08-5.46v3.2c-1.7-.55-3.83.3-3.83 2.2 0 1.45 1.13 2.5 2.55 2.5 1.6 0 2.58-1.22 2.58-2.78V3h3.12Z" />
    </svg>`,
  },
  {
    name: 'Facebook',
    handle: 'redvelvet pasteleria',
    url: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M14.1 21v-7.4h2.48l.38-2.88H14.1V8.88c0-.83.23-1.4 1.43-1.4h1.52V4.9c-.26-.04-1.17-.11-2.23-.11-2.2 0-3.7 1.34-3.7 3.8v2.13H8.63v2.88h2.49V21h2.98Z" />
    </svg>`,
  },
];
---

<section id="contacto" class="relative overflow-hidden bg-cream py-20 pb-28 md:py-28 md:pb-36">
  <div class="section-shell">
    <div class="grid overflow-hidden rounded-lg border-2 border-black bg-white shadow-[8px_8px_0_#080808] md:grid-cols-[1fr_0.9fr]">
      <div class="p-7 md:p-10 lg:p-12">
        <p class="eyebrow mb-5">Estamos para ti</p>
        <h2 class="display-title text-5xl sm:text-6xl">Agenda tu próximo pedido.</h2>
        <p class="mt-5 max-w-xl text-base font-bold leading-8 text-black/70">
          Escríbenos con la fecha, número de personas e idea general. Te respondemos con opciones para aterrizarlo sin vueltas.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
            WhatsApp
          </a>
          <a href={`mailto:${EMAIL}`} class="btn-secondary">
            Email
          </a>
        </div>

        <div class="mt-9 grid gap-3 sm:grid-cols-3">
          {socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer" class="min-w-0 rounded-lg border-2 border-black bg-cream p-4 shadow-[4px_4px_0_#080808] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0_#080808]">
              <span class="mb-4 grid h-11 w-11 place-items-center rounded-md border-2 border-black bg-white text-primary [&_svg]:h-6 [&_svg]:w-6">
                <span set:html={social.icon} />
              </span>
              <span class="block text-xs font-black uppercase text-primary">{social.name}</span>
              <span class="mt-1 block [overflow-wrap:anywhere] text-sm font-black leading-5 text-black">{social.handle}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="relative min-h-80 border-t-2 border-black bg-primary md:border-l-2 md:border-t-0">
        <img
          src="https://images.unsplash.com/photo-1519869325930-281384150729?auto=format&fit=crop&w=900&q=85"
          alt="Postres decorados sobre mesa"
          class="absolute inset-0 h-full w-full object-cover mix-blend-multiply saturate-125"
          loading="lazy"
        />
        <div class="absolute inset-x-5 bottom-5 rounded-md border-2 border-black bg-cream p-5 shadow-[4px_4px_0_#080808]">
          <p class="font-body text-3xl font-black text-black">Veracruz, México</p>
          <p class="mt-2 text-sm font-bold leading-6 text-black/70">Pedidos personalizados, postres para compartir y mesas dulces para eventos.</p>
        </div>
      </div>
    </div>
  </div>

  <svg class="section-wave text-black" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34L1440 80L0 80Z" />
    <path fill="none" stroke="#080808" stroke-width="4" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34" />
  </svg>
</section>
