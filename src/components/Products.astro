---
const products = [
  {
    name: 'Pasteles personalizados',
    description: 'Diseños únicos para cada ocasión especial.',
    tone: 'bg-white',
    image: 'https://images.unsplash.com/photo-1464349153735-7db50ed83c84?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Mostachón',
    description: 'Merengue suave con frutas frescas y crema ligera.',
    tone: 'bg-secondary',
    image: 'https://images.unsplash.com/photo-1488477304112-4944851de03d?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Cheesecakes',
    description: 'Cremosos, equilibrados y con toppings de temporada.',
    tone: 'bg-white',
    image: 'https://images.unsplash.com/photo-1533134242443-d4fd215305ad?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Pays',
    description: 'Recetas tradicionales con rellenos llenos de sabor.',
    tone: 'bg-cream',
    image: 'https://images.unsplash.com/photo-1621303837174-89787a7d4729?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Cupcakes',
    description: 'Individuales, decorados y listos para compartir.',
    tone: 'bg-secondary',
    image: 'https://images.unsplash.com/photo-1486427944299-d1955d23e34d?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Mini cakes',
    description: 'Pequeños pasteles con presentación especial.',
    tone: 'bg-white',
    image: 'https://images.unsplash.com/photo-1586985289688-ca3cf47d3e6e?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Donas con toppings',
    description: 'Suaves y cubiertas con tus combinaciones favoritas.',
    tone: 'bg-cream',
    image: 'https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Fresas con chocolate',
    description: 'Fresas frescas bañadas y decoradas al momento.',
    tone: 'bg-secondary',
    image: 'https://images.unsplash.com/photo-1577003833619-76bbd7f82948?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'Brownies con toppings',
    description: 'Húmedos, intensos y personalizados.',
    tone: 'bg-white',
    image: 'https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=420&q=80',
  },
  {
    name: 'New York cookies',
    description: 'Grandes, suaves por dentro y doradas por fuera.',
    tone: 'bg-cream',
    image: 'https://images.unsplash.com/photo-1499636136210-6f4ee915583e?auto=format&fit=crop&w=420&q=80',
  },
];
---

<section id="productos" class="relative overflow-hidden bg-cream py-20 pb-28 md:py-28 md:pb-36">
  <div class="section-shell">
    <div class="mb-12 grid gap-6 md:grid-cols-[0.8fr_1fr] md:items-end">
      <div>
        <p class="eyebrow mb-4">Lo que hacemos</p>
        <h2 class="display-title text-5xl sm:text-6xl md:text-7xl">Productos con antojo real</h2>
      </div>
      <p class="max-w-2xl text-base font-bold leading-8 text-black/74 md:justify-self-end md:text-right">
        Aquí está el menú base para elegir algo clásico o pedir una idea completamente personalizada.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {products.map((product, index) => (
        <article class={`group min-h-64 overflow-hidden rounded-lg border-2 border-black shadow-[5px_5px_0_#080808] transition duration-200 hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0_#080808] ${product.tone}`}>
          <div class="relative h-28 border-b-2 border-black bg-primary">
            <img
              src={product.image}
              alt={product.name}
              class="h-full w-full object-cover mix-blend-multiply saturate-125 transition duration-200 group-hover:scale-105"
              loading="eager"
            />
            <span class="absolute left-3 top-3 grid h-9 w-9 place-items-center rounded-md border-2 border-black bg-cream text-xs font-black text-primary">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-body text-xl font-black leading-6 text-black">{product.name}</h3>
            <p class="mt-3 text-sm font-bold leading-6 text-black/68">{product.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 grid overflow-hidden rounded-lg border-2 border-black bg-primary text-white shadow-[7px_7px_0_#080808] md:grid-cols-[1fr_auto]">
      <div class="p-7 md:p-9">
        <p class="font-body text-3xl font-black">¿No ves exactamente lo que buscas?</p>
        <p class="mt-2 max-w-xl text-sm font-bold leading-7 text-white/82">Cuéntanos la idea, el número de invitados y la fecha. Te ayudamos a convertirlo en una propuesta clara.</p>
      </div>
      <div class="flex items-center border-t-2 border-black p-7 md:border-l-2 md:border-t-0 md:p-9">
        <a href="/#contacto" class="btn-light">
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
          </svg>
          Personalizar pedido
        </a>
      </div>
    </div>
  </div>

  <svg class="section-wave text-secondary" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34L1440 80L0 80Z" />
    <path fill="none" stroke="#080808" stroke-width="4" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34" />
  </svg>
</section>
