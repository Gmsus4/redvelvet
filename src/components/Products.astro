---
// Products.astro — Red Velvet Bakery · Tailwind CSS

const products = [
  {
    id: "01",
    name: "Pasteles personalizados",
    desc: "Diseños únicos para cada ocasión especial.",
    img: "/images/products/pasteles.jpg",
  },
  {
    id: "02",
    name: "Mostachón",
    desc: "Merengue suave con frutas frescas y crema ligera.",
    img: "/images/products/mostachon.jpg",
  },
  {
    id: "03",
    name: "Cheesecakes",
    desc: "Cremosos, equilibrados y con toppings de temporada.",
    img: "/images/products/cheesecake.jpg",
  },
  {
    id: "04",
    name: "Pays",
    desc: "Recetas tradicionales con rellenos llenos de sabor.",
    img: "/images/products/pays.jpg",
  },
  {
    id: "05",
    name: "Cupcakes",
    desc: "Individuales, decorados y listos para compartir.",
    img: "/images/products/cupcakes.jpg",
  },
  {
    id: "06",
    name: "Mini cakes",
    desc: "Pequeños pasteles con presentación especial.",
    img: "/images/products/minicakes.jpg",
  },
  {
    id: "07",
    name: "Donas con toppings",
    desc: "Suaves y cubiertas con tus combinaciones favoritas.",
    img: "/images/products/donas.jpg",
  },
  {
    id: "08",
    name: "Fresas con chocolate",
    desc: "Fresas frescas bañadas y decoradas al momento.",
    img: "/images/products/fresas.jpg",
  },
  {
    id: "09",
    name: "Brownies con toppings",
    desc: "Húmedos, intensos y personalizados.",
    img: "/images/products/brownies.jpg",
  },
  {
    id: "10",
    name: "New York cookies",
    desc: "Grandes, suaves por dentro y doradas por fuera.",
    img: "/images/products/cookies.jpg",
  },
];
---

<section class="bg-paper py-20 px-6 font-body text-ink">
  <div class="mx-auto max-w-6xl">

    <!-- ── Encabezado ── -->
    <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <!-- Etiqueta -->
        <span class="mb-4 inline-block rounded-full border-2 border-ink px-4 py-1 text-xs font-bold uppercase tracking-[.16em] text-ink">
          Lo que hacemos
        </span>
        <h2 class="max-w-[12ch] font-hero text-[clamp(2.8rem,8vw,1.25rem)] font-normal leading-[0.95] text-secondary md:max-w-[12ch]">
          Productos con<br>antojo real
        </h2>
      </div>
      <p class="max-w-xs text-right text-sm leading-relaxed text-muted lg:max-w-[280px]">
        Aquí está el menú base para elegir algo clásico o pedir una idea completamente personalizada.
      </p>
    </div>

    <!-- ── Grid de productos ── -->
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {products.map(({ id, name, desc, img }) => (
        <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-secondary/30 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_40px_#ef2f7f22]">

          <!-- Imagen con overlay al hover -->
          <div class="relative h-40 overflow-hidden bg-muted/10">
            <img
              src={img}
              alt={name}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <!-- Overlay degradado -->
            <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

            <!-- Número -->
            <span class="absolute left-2 top-2 rounded-md bg-primary px-2 py-0.5 font-display text-xs font-bold text-white">
              {id}
            </span>
          </div>

          <!-- Texto -->
          <div class="flex flex-1 flex-col gap-1.5 p-4">
            <h3 class="font-display text-base font-bold leading-tight text-ink">
              {name}
            </h3>
            <p class="text-xs leading-relaxed text-muted">
              {desc}
            </p>
          </div>

          <!-- Línea de acento al hover -->
          <div class="h-0.5 w-0 bg-primary transition-all duration-300 group-hover:w-full"></div>
        </li>
      ))}
    </ul>

    <!-- ── Banner CTA ── -->
    <div class="mt-10 flex flex-col items-start justify-between gap-6 rounded-2xl bg-primary p-8 sm:flex-row sm:items-center">
      <div>
        <h3 class="font-display text-xl font-black text-white leading-snug">
          ¿No ves exactamente lo que buscas?
        </h3>
        <p class="mt-1.5 max-w-md text-sm leading-relaxed text-white/80">
          Cuéntanos la idea, el número de invitados y la fecha. Te ayudamos a convertirlo en una propuesta clara.
        </p>
      </div>
      <a
        href="#pedidos"
        class="shrink-0 flex items-center gap-2 rounded-xl border-2 border-white bg-transparent px-6 py-3 text-sm font-bold text-white transition-all duration-200 hover:bg-white hover:text-primary"
      >
        <span class="text-lg">+</span> Personalizar pedido
      </a>
    </div>

  </div>
</section>