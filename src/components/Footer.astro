---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Productos', href: '/#productos' },
  { label: 'Eventos', href: '/#eventos' },
  { label: 'Cuidados', href: '/#recomendaciones' },
  { label: 'Experiencia', href: '/#experiencia' },
  { label: 'Conócenos', href: '/#conocenos' },
  { label: 'Contacto', href: '/#contacto' },
];

const legalLinks = [
  { label: 'Términos y condiciones', href: '/terminos-y-condiciones' },
  { label: 'Política de privacidad', href: '/politica-de-privacidad' },
];
---

<footer class="bg-black text-white">
  <div class="section-shell py-12">
    <div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <span class="grid h-11 w-11 place-items-center rounded-md border-2 border-white bg-primary text-lg font-black text-white">rv</span>
          <span>
            <span class="block font-display text-2xl font-bold text-white">redvelvet</span>
            <span class="block text-xs font-bold text-white">pastelería artesanal</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm font-bold leading-7 text-white">
          Pasteles y postres artesanales hechos con amor en Veracruz. Cada creación se prepara con intención, sabor y buena presentación.
        </p>
      </div>

      <nav aria-label="Navegación del pie de página">
        <h3 class="font-body text-xl font-black text-white">Navegación</h3>
        <ul class="mt-4 grid gap-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm font-bold text-white transition hover:text-secondary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="font-body text-xl font-black text-white">Información</h3>
        <ul class="mt-4 grid gap-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm font-bold text-white transition hover:text-secondary">{link.label}</a>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm font-bold text-white">Veracruz, México</p>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t-2 border-white pt-6 text-xs font-bold text-white sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} redvelvet_pasteleria. Todos los derechos reservados.</p>
      <p>Hecho con cuidado en Veracruz.</p>
    </div>
  </div>
</footer>
