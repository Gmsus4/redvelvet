---
const GOOGLE_FORM_URL = '#';

const testimonials = [
  {
    name: 'Ana G.',
    location: 'Veracruz',
    initial: 'A',
    comment: 'El pastel de cumpleaños quedó exactamente como lo pedí. Todos mis invitados quedaron encantados.',
  },
  {
    name: 'María L.',
    location: 'Veracruz',
    initial: 'M',
    comment: 'Las fresas con chocolate para mi boda fueron un éxito total. Las volvería a contratar sin dudarlo.',
  },
];
---

<section id="experiencia" class="relative overflow-hidden bg-cream py-20 pb-28 md:py-28 md:pb-36">
  <div class="section-shell grid gap-12 md:grid-cols-[0.92fr_1.08fr] md:items-center">
    <div>
      <p class="eyebrow mb-5">Tu opinión nos importa</p>
      <h2 class="display-title text-5xl sm:text-6xl md:text-7xl">Cuéntanos tu experiencia.</h2>
      <p class="mt-6 max-w-lg text-base font-bold leading-8 text-black/70">
        Cada comentario nos ayuda a crecer y seguir mejorando. Si ya probaste alguno de nuestros productos, nos encantaría saber qué te pareció.
      </p>

      <div class="mt-7 flex items-center gap-1 text-primary" aria-label="Calificación de cinco estrellas">
        {Array.from({ length: 5 }).map(() => (
          <svg aria-hidden="true" class="h-6 w-6 fill-current stroke-black stroke-[1.4]" viewBox="0 0 24 24">
            <path d="m12 2.8 2.8 5.68 6.27.91-4.54 4.42 1.07 6.24L12 17.1l-5.6 2.95 1.07-6.24-4.54-4.42 6.27-.91L12 2.8Z" />
          </svg>
        ))}
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Compartir experiencia
        </a>
        <div class="soft-card flex items-center gap-3 bg-white px-4 py-3">
          <span class="font-body text-2xl font-black text-primary">+50</span>
          <span class="text-sm font-black text-black">reseñas de clientes</span>
        </div>
      </div>
    </div>

    <div class="grid gap-4">
      {testimonials.map((t) => (
        <article class="rounded-lg border-2 border-black bg-white p-6 shadow-[5px_5px_0_#080808]">
          <div class="mb-4 flex items-center gap-1 text-primary">
            {Array.from({ length: 5 }).map(() => (
              <svg aria-hidden="true" class="h-4 w-4 fill-current stroke-black stroke-[1.4]" viewBox="0 0 24 24">
                <path d="m12 2.8 2.8 5.68 6.27.91-4.54 4.42 1.07 6.24L12 17.1l-5.6 2.95 1.07-6.24-4.54-4.42 6.27-.91L12 2.8Z" />
              </svg>
            ))}
          </div>
          <p class="text-base font-bold leading-8 text-black">"{t.comment}"</p>
          <div class="mt-5 flex items-center gap-3 border-t-2 border-black pt-4">
            <span class="grid h-10 w-10 place-items-center rounded-md border-2 border-black bg-primary font-body font-black text-white">{t.initial}</span>
            <span>
              <span class="block text-sm font-black text-black">{t.name}</span>
              <span class="block text-xs font-bold text-black/60">{t.location}</span>
            </span>
            <span class="ml-auto rounded-md border-2 border-black bg-secondary px-3 py-1 text-xs font-black text-black">Verificado</span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <svg class="section-wave text-secondary" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34L1440 80L0 80Z" />
    <path fill="none" stroke="#080808" stroke-width="4" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34" />
  </svg>
</section>
