---
// Navbar.astro — Responsive + hamburguesa funcional

interface NavLink {
  label: string;
  href: string;
  muted?: boolean;
}

const leftLinks: NavLink[] = [
  { label: "Work",  href: "/work"  },
  { label: "Craft", href: "/craft" },
];

const rightLinks: NavLink[] = [
  { label: "About",  href: "/about"  },
  { label: "Resume", href: "/resume" },
];

const allLinks = [...leftLinks, ...rightLinks];
---

<header class="fixed left-0 right-0 top-2 z-50 bg-transparent font-sans">

  <!-- ── Barra principal ── -->
  <nav class="max-w-5xl mx-auto px-6 h-16 relative flex items-center justify-between md:grid md:grid-cols-[1fr_auto_1fr]">

    <!-- Links izquierdos — ocultos en mobile -->
    <ul class="hidden md:flex items-center justify-end gap-8 list-none m-0 p-0">
      {leftLinks.map(({ label, href, muted }) => (
        <li>
          <a
            href={href}
            class:list={[
              "text-base font-medium tracking-wide relative transition-colors duration-150",
              "after:absolute after:bottom-[-2px] after:left-0 after:w-0 after:h-px",
              "after:transition-all after:duration-150 hover:after:w-full",
              muted
                ? "text-neutral-400 hover:text-neutral-900 after:bg-neutral-900"
                : "text-primary/70 hover:text-primary",
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Brand: centrado absoluto en mobile, columna central en desktop -->
    <a
      href="/"
      class="font-[Caveat] text-[3rem] font-bold text-primary no-underline
             leading-none tracking-tight text-center
             absolute left-1/2 -translate-x-1/2
             md:static md:translate-x-0 md:px-10
             hover:opacity-60 transition-opacity duration-150"
    >
      Redvelvet
    </a>

    <!-- Links derechos — ocultos en mobile -->
    <ul class="hidden md:flex items-center justify-start gap-8 list-none m-0 p-0">
      {rightLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="text-base font-medium tracking-wide text-primary/70 hover:text-primary relative"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Hamburguesa — visible solo en mobile, en col 3 -->
    <button
      id="hamburger-btn"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden col-start-3 justify-self-end flex flex-col justify-between
             w-6 h-[14px] bg-transparent border-0 cursor-pointer p-0"
    >
      <span id="h-line1" class="block w-full h-px bg-neutral-900 rounded origin-center transition-all duration-300"></span>
      <span id="h-line2" class="block w-full h-px bg-neutral-900 rounded transition-all duration-300"></span>
      <span id="h-line3" class="block w-full h-px bg-neutral-900 rounded origin-center transition-all duration-300"></span>
    </button>
  </nav>

  <!-- ── Menú mobile desplegable ── -->
  <div
    id="mobile-menu"
    aria-hidden="true"
    class="md:hidden overflow-hidden transition-[max-height] duration-300 ease-in-out"
    style="max-height: 0px;"
  >
    <ul class="flex flex-col items-center gap-6 list-none m-0 py-6 px-0 border-t border-neutral-100">
      {allLinks.map(({ label, href, muted }) => (
        <li>
          <a
            href={href}
            class:list={[
              "text-base font-light no-underline transition-colors duration-150",
              muted
                ? "text-neutral-400 hover:text-neutral-900"
                : "text-neutral-900 hover:text-neutral-400",
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet" />

<script>
  const btn   = document.getElementById('hamburger-btn') as HTMLButtonElement;
  const menu  = document.getElementById('mobile-menu')  as HTMLDivElement;
  const line1 = document.getElementById('h-line1')      as HTMLSpanElement;
  const line2 = document.getElementById('h-line2')      as HTMLSpanElement;
  const line3 = document.getElementById('h-line3')      as HTMLSpanElement;

  btn.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';

    btn.setAttribute('aria-expanded', String(!isOpen));
    menu.setAttribute('aria-hidden',  String(isOpen));

    // Abrir / cerrar con scrollHeight real
    menu.style.maxHeight = isOpen ? '0px' : `${menu.scrollHeight}px`;

    // Hamburguesa → X
    if (!isOpen) {
      line1.style.transform = 'translateY(7px) rotate(45deg)';
      line2.style.opacity   = '0';
      line3.style.transform = 'translateY(-7px) rotate(-45deg)';
    } else {
      line1.style.transform = '';
      line2.style.opacity   = '';
      line3.style.transform = '';
    }
  });
</script>