---
const socials = [
  {
    name: 'Instagram',
    url: '#',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5h.01" />
    </svg>`,
  },
  {
    name: 'TikTok',
    url: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.7 3c.42 2.46 1.78 3.95 4.1 4.1v3.05a7.2 7.2 0 0 1-4.05-1.25v6.15c0 3.2-2.36 5.95-5.77 5.95-3.16 0-5.78-2.37-5.78-5.62 0-3.66 3.46-6.33 7.08-5.46v3.2c-1.7-.55-3.83.3-3.83 2.2 0 1.45 1.13 2.5 2.55 2.5 1.6 0 2.58-1.22 2.58-2.78V3h3.12Z" />
    </svg>`,
  },
  {
    name: 'Facebook',
    url: '#',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M14.1 21v-7.4h2.48l.38-2.88H14.1V8.88c0-.83.23-1.4 1.43-1.4h1.52V4.9c-.26-.04-1.17-.11-2.23-.11-2.2 0-3.7 1.34-3.7 3.8v2.13H8.63v2.88h2.49V21h2.98Z" />
    </svg>`,
  },
];
---

<section class="grid place-items-center h-screen w-full">
  <div class="max-w-5xl relative bg-amber-600/05 w-full">
    <img src="/fondo3.png" alt="" class="absolute -top-50 z-10 hidden md:flex">
    <img src="/fondo4.png" alt="" class="absolute -bottom-40 z-10">
    <div class="flex flex-col items-center gap-10 ">
      <p class="text-primary z-20 font-[caveat] text-5xl text-center">Hello! I'm Belle, <br>I'm a designer who <br>makes magic through <br> product & brand.</p>
      <div class="z-20 flex items-center gap-4">
        <a href="" class="px-6 py-2 bg-primary rounded-full text-white text-sm">dsd</a>
        <div class="z-20 flex flex-col ">
          <span class="z-20 text-primary font-bold text-center md:text-left">Fresco y delicioso</span>
          <span class="text-center z-20 text-softcopy text-sm text-center md:text-left">desde 2020</span>
        </div>
      </div>
    </div>
    <div class="absolute lg:-bottom-40 -bottom-70 left-1/2 z-30 flex w-full max-w-xl -translate-x-1/2 flex-wrap items-center justify-center gap-3 px-2">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.name}
          class="group inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-primary bg-cream/95 px-4 text-sm font-black text-primary shadow-[3px_3px_0_#ef2f7f] backdrop-blur transition hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-primary hover:text-white hover:shadow-[1px_1px_0_#ef2f7f]"
        >
          <span class="grid h-5 w-5 place-items-center [&_svg]:h-5 [&_svg]:w-5">
            <span set:html={social.icon} />
          </span>
          <span>{social.name}</span>
        </a>
      ))}
    </div>
  </div>
  </div>
</section>
