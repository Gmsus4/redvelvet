---
const features = [
  { title: 'Pasteles de evento', description: 'Bodas, XV años, cumpleaños y celebraciones familiares.' },
  { title: 'Mesa de postres', description: 'Surtido variado, montado con orden y buena presentación.' },
  { title: 'Decoración temática', description: 'Colores, estilo y detalles pensados para tu celebración.' },
  { title: 'Paquetes a tu medida', description: 'Opciones según invitados, presupuesto y tipo de evento.' },
];
---

<section id="eventos" class="relative overflow-hidden bg-secondary py-20 pb-28 text-black md:py-28 md:pb-36">
  <div class="section-shell relative grid gap-12 md:grid-cols-[0.95fr_1.05fr] md:items-center">
    <div class="relative">
      <div class="pop-frame overflow-hidden bg-cream">
        <img
          src="https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=1000&q=85"
          alt="Mesa con postres decorados para evento"
          class="aspect-[4/5] w-full object-cover mix-blend-multiply saturate-125"
          loading="lazy"
        />
      </div>
      <div class="absolute -bottom-5 left-5 right-5 rounded-md border-2 border-black bg-white p-4 shadow-[5px_5px_0_#080808]">
        <p class="text-sm font-black uppercase text-primary">Evento completo</p>
        <p class="mt-1 font-body text-2xl font-black">Pastel, postres y una mesa que sí se ve cuidada.</p>
      </div>
    </div>

    <div class="pt-6 md:pt-0">
      <p class="eyebrow mb-5">Para tus celebraciones</p>
      <h2 class="display-title text-5xl sm:text-6xl md:text-7xl">
        Mesas dulces y pasteles para eventos.
      </h2>
      <p class="mt-6 max-w-xl text-base font-bold leading-8 text-black/72">
        Desde una reunión pequeña hasta una boda, armamos una propuesta dulce que combine con tu evento y se sienta hecha especialmente para ti.
      </p>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {features.map((feature) => (
          <article class="rounded-lg border-2 border-black bg-white p-5 shadow-[4px_4px_0_#080808] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0_#080808]">
            <h3 class="font-body text-xl font-black text-black">{feature.title}</h3>
            <p class="mt-2 text-sm font-bold leading-6 text-black/64">{feature.description}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/#contacto" class="btn-primary">
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8M8 12h5M5 21l3-3h10a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v9a3 3 0 0 0 3 3" />
          </svg>
          Cotizar evento
        </a>
        <a href="/#productos" class="btn-light">Ver opciones</a>
      </div>
    </div>
  </div>

  <svg class="section-wave text-primary" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34L1440 80L0 80Z" />
    <path fill="none" stroke="#080808" stroke-width="4" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34" />
  </svg>
</section>
