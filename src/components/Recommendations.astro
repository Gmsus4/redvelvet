---
const recommendations = [
  {
    title: 'Evita el sol directo',
    description: 'Mantén tus postres lejos de luz solar directa para proteger la decoración, el betún y la frescura.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>`,
  },
  {
    title: 'Refrigeración, no congelación',
    description: 'Guárdalos en refrigeración. Congelarlos puede cambiar la textura y afectar la presentación.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2v20M4.93 4.93l14.14 14.14M2 12h20M4.93 19.07 19.07 4.93" />
      <path d="m8 4 4 4 4-4M8 20l4-4 4 4M4 8l4 4-4 4M20 8l-4 4 4 4" />
    </svg>`,
  },
  {
    title: 'Sácalo antes de servir',
    description: 'Retíralo del refrigerador de 20 a 30 minutos antes de tu evento para disfrutar mejor su sabor.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="13" r="8" />
      <path d="M12 9v5l3 2M9 2h6M12 2v3" />
    </svg>`,
  },
];
---

<section id="recomendaciones" class="relative overflow-hidden bg-primary py-20 pb-28 md:py-28 md:pb-36">
  <div class="section-shell">
    <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start">
      <div class="md:sticky md:top-28">
        <p class="eyebrow mb-5">Cuidados importantes</p>
        <h2 class="display-title text-5xl text-white sm:text-6xl">Que llegue y luzca como lo imaginaste.</h2>
        <p class="mt-5 text-base font-bold leading-8 text-black/72">
          Tres recomendaciones simples para cuidar tu pedido antes del primer corte.
        </p>
      </div>

      <div class="grid gap-4">
        {recommendations.map((rec) => (
          <article class="grid gap-4 rounded-lg border-2 border-black bg-cream p-5 shadow-[5px_5px_0_#080808] sm:grid-cols-[auto_1fr]">
            <span class="grid h-14 w-14 place-items-center rounded-md border-2 border-black bg-white text-primary [&_svg]:h-7 [&_svg]:w-7">
              <span set:html={rec.icon} />
            </span>
            <div>
              <h3 class="font-body text-2xl font-black text-black">{rec.title}</h3>
              <p class="mt-2 text-sm font-bold leading-7 text-black/68">{rec.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <svg class="section-wave text-cream" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34L1440 80L0 80Z" />
    <path fill="none" stroke="#080808" stroke-width="4" d="M0 34C60 56 120 56 180 34C240 12 300 12 360 34C420 56 480 56 540 34C600 12 660 12 720 34C780 56 840 56 900 34C960 12 1020 12 1080 34C1140 56 1200 56 1260 34C1320 12 1380 12 1440 34" />
  </svg>
</section>
