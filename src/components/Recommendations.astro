---
const recomendaciones = [
  {
    image: "/sun.png",
    title: "NUNCA EXPONER",
    description: "Tus postres a sol directo.",
  },
  {
    image: "/ice.png",
    title: "SIEMPRE MANTENER",
    description: "Tu producto en refrigeración, nunca congelación.",
  },
  {
    image: "/clock.png",
    title: "PARA TU EVENTO",
    description: "Sacar del refrigerador el producto de 20 a 30 minutos antes.",
  },
];
---

<div class="py-10 md:py-20">
  <div class="grid w-full place-items-center gap-6 md:gap-16">
    <h2 class="w-full text-center font-[Caveat] text-5xl text-primary md:text-6xl">Recomendaciones</h2>

    <div class="grid w-full max-w-5xl grid-cols-1 gap-10 md:grid-cols-3 md:gap-10">
      {recomendaciones.map((item) => (
        <div class="flex flex-col items-center gap-4 text-center">
          <img src={item.image} alt="" class="h-32 w-30 object-contain md:h-36" />
          <h3 class="text-sm font-black leading-tight text-primary">{item.title}</h3>
          <p class="max-w-56 text-base font-bold leading-7 text-copy">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>
